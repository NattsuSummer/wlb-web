{
  "name": "wlb-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend for Balance Our Day (React + esbuild, Cloudflare Pages)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name balance-our-day"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  }
}
